6040 GOTO 9000

1000 REM RENDER SNAKE
1010 COLOR = 12 : PLOT SN(SH,0), SN(SH,1)
1020 RETURN 

1100 IF ((SN(ST,0)>4) AND (SN(ST,0)<8)) AND (SN(ST,1)=6) GOTO 3040
1110 IF ((SN(ST,1)>4) AND (SN(ST,1)<8)) AND (SN(ST,0)=6) GOTO 3040
1120 IF ((SN(ST,0)>32) AND (SN(ST,0)<36)) AND (SN(ST,1)=34) GOTO 3040
1130 IF ((SN(ST,1)>32) AND (SN(ST,1)<36)) AND (SN(ST,0)=34) GOTO 3040
1140 GOTO 3030

1150 IF ((SN(ST,0)>4) AND (SN(ST,0)<8)) AND (SN(ST,1)=34) GOTO 3040
1160 IF ((SN(ST,1)>32) AND (SN(ST,1)<36)) AND (SN(ST,0)=6) GOTO 3040
1170 IF ((SN(ST,0)>32) AND (SN(ST,0)<36)) AND (SN(ST,1)=6) GOTO 3040
1180 IF ((SN(ST,1)>4) AND (SN(ST,1)<8)) AND (SN(ST,0)=34) GOTO 3040
1190 GOTO 3030

1200 IF ((SN(ST,0)> 4) AND (SN(ST,0)<16)) AND (SN(ST,1)=20) GOTO 3040
1210 IF ((SN(ST,0)>24) AND (SN(ST,0)<36)) AND (SN(ST,1)=20) GOTO 3040
1220 GOTO 3030

1250 IF (SN(ST,0)=11) THEN IF (SN(ST,1)<11) OR (SN(ST,1)>16) GOTO 3040
1260 IF (SN(ST,0)=29) THEN IF (SN(ST,1)<26) OR (SN(ST,1)>30) GOTO 3040
1270 GOTO 3030

1300 GOTO 3030
1350 GOTO 3030
1400 GOTO 3030
1450 GOTO 3030

1500 REM ADD FOOD
1510 SC = SC + 10 
1520 FX% = RND(1) * 36 + 2 : FY% = RND(1) * 36 + 2
1530 IF (SCRN(FX%,FY%)<>0) THEN GOTO 1520
1535 IF SC>=300 THEN RE = 0 : GOSUB 2500 : IF RE = 1 GOTO 1520 
1536 IF (FX%=10 OR FX%=11 OR FX%=12 OR FX%=28 OR FX%=29 OR FX%=30) GOTO 1520
1537 IF (FY%=19 OR FY%=20 OR FY%=21) GOTO 1520
