270 GOSUB 3700 : REM READ HI SCORES AND DISPLAY THEM
280 GR 

300 HTAB 1 : VTAB 21 : PRINT "                                        "
310 COLOR = 15 : HLIN 0,39 AT 0 : HLIN 0,39 AT 39 : VLIN 0,39 AT 0 : VLIN 0,39 AT 39
320 COLOR = 15 : HLIN 0,39 AT 0 : HLIN 0,39 AT 39 : VLIN 0,39 AT 0 : VLIN 0,39 AT 39
330 ST = 0 : DX = 1 : DY = 0 : SZ = 3 : GW = 0 : LV = 1 : DE = 125 : SC = 0 : IN = 0 : MV = 0
340 SH = SZ - 1

350 REM DRAW SNAKE INITIAL POSITION
360 FOR X = 0 TO SZ-1 : SN(X,0) = X+1 : SN(X,1) = 24 : NEXT X
370 COLOR = 12 : GOSUB 4300
380 GOSUB 1500

390 REM GAME TITLE
400 HTAB 12 : VTAB 21
410 PRINT "COBRAS BY NELBR";

500 REM GAME LOOP
510 GOSUB 1000 : REM RENDER SNAKE AFTER MOVEMENT
520 GOSUB 2000 : REM READ KEYBOARD AND UPDATE DIRECTION
530 GOSUB 3000 : REM PROCESS MOVEMENT
540 FOR X=1 TO DE : NEXT X : REM DELAY FOR SPEED MGMT
560 GOTO 500

1000 REM RENDER SNAKE
1020 COLOR = 0  
1030 IF (GW=0) THEN ON LV GOTO 1450, 1450, 1450, 1100, 1150, 1200, 1250, 1450, 1450, 1400
1040 COLOR = 1 
1050 PLOT FX%,FY% 
1060 COLOR = 12
1070 PLOT SN(SH,0), SN(SH,1)
1080 GW = 0
1090 RETURN 

1100 IF ((SN(ST,0)>4) AND (SN(ST,0)<8)) AND (SN(ST,1)=6) GOTO 1040
1110 IF ((SN(ST,1)>4) AND (SN(ST,1)<8)) AND (SN(ST,0)=6) GOTO 1040
1120 IF ((SN(ST,0)>32) AND (SN(ST,0)<36)) AND (SN(ST,1)=34) GOTO 1040
1130 IF ((SN(ST,1)>32) AND (SN(ST,1)<36)) AND (SN(ST,0)=34) GOTO 1040
1140 PLOT SN(ST,0), SN(ST,1) : GOTO 1040

1150 IF ((SN(ST,0)>4) AND (SN(ST,0)<8)) AND (SN(ST,1)=34) GOTO 1040
1160 IF ((SN(ST,1)>32) AND (SN(ST,1)<36)) AND (SN(ST,0)=6) GOTO 1040
1170 IF ((SN(ST,0)>32) AND (SN(ST,0)<36)) AND (SN(ST,1)=6) GOTO 1040
1180 IF ((SN(ST,1)>4) AND (SN(ST,1)<8)) AND (SN(ST,0)=34) GOTO 1040
1190 PLOT SN(ST,0), SN(ST,1) : GOTO 1040

1200 IF ((SN(ST,0)> 4) AND (SN(ST,0)<16)) AND (SN(ST,1)=20) GOTO 1040
1210 IF ((SN(ST,0)>24) AND (SN(ST,0)<36)) AND (SN(ST,1)=20) GOTO 1040
1220 PLOT SN(ST,0), SN(ST,1) : GOTO 1040

1250 IF (SN(ST,0)=11) THEN IF (SN(ST,1)<11) OR (SN(ST,1)>16) GOTO 1040
1260 IF (SN(ST,0)=29) THEN IF (SN(ST,1)<26) OR (SN(ST,1)>30) GOTO 1040
1270 PLOT SN(ST,0), SN(ST,1) : GOTO 1040

1300 GOTO 1040
1350 GOTO 1040
1400 GOTO 1040
1450 PLOT SN(ST,0), SN(ST,1) : GOTO 1040

1500 REM ADD FOOD
1510 FX% = RND(1) * 36 + 2
1520 FY% = RND(1) * 36 + 2
1530 IF (SCRN(FX%,FY%)=12) THEN GOTO 1510
1535 IF SC>=300 THEN RE = 0 : GOSUB 2500 : IF RE = 1 GOTO 1510 
1536 IF (FX%=10 OR FX%=11 OR FX%=12 OR FX%=28 OR FX%=29 OR FX%=30) GOTO 1510
1537 IF (FY%=19 OR FY%=20 OR FY%=21) GOTO 1510
1540 HTAB 1 : VTAB 23 : PI = 4 : GOSUB 4000 : GOSUB 4000
1550 IF SC = 0   THEN                     PRINT "LEVEL "; LV;  " BASE GAME!        "
1560 IF SC = 100 THEN LV = 2 : DE = 100 : PRINT "LEVEL "; LV;  " GETTING FASTER!   " : GOSUB 4400
1570 IF SC = 200 THEN LV = 3 : DE = 75  : PRINT "LEVEL "; LV;  " EVEN FASTER!      " : GOSUB 4400
1580 IF SC = 300 THEN LV = 4 : DE = 60  : PRINT "LEVEL "; LV;  " OH NO, MINES!     " : GOSUB 4400 : COLOR = 12 : GOSUB 4800
1590 IF SC = 400 THEN LV = 5 : DE = 60  : PRINT "LEVEL "; LV;  " OH NO, MORE MINES!" : GOSUB 4400 : COLOR = 12 : GOSUB 4900
1600 IF SC = 500 THEN LV = 6 : DE = 60  : PRINT "LEVEL "; LV;  " ELECTRIFIED WALL  " : GOSUB 4400 : COLOR = 12 : HLIN 5,15 AT 20 : HLIN 25,35 AT 20
1610 IF SC = 600 THEN LV = 7 : DE = 60  : PRINT "LEVEL "; LV;  " TWO WALLS NOW     " : GOSUB 4400 : COLOR = 0  : HLIN 2,38 AT 20 : GOSUB 4800 : GOSUB 4900 
1620 IF SC = 600 THEN COLOR = 12 : VLIN 1,10 AT 11 : VLIN 16,38 AT 11 : VLIN 1,25 AT 29 : VLIN 31,38 AT 29 
1630 IF SC = 700 THEN LV = 8 : DE = 60  : PRINT "LEVEL "; LV;  " MOVING WALLS      " : GOSUB 4400 : COLOR = 12 : VLIN 1,10 AT 11 : VLIN 16,38 AT 11 : VLIN 1,25 AT 29 : VLIN 31,38 AT 29 : MV = 16 : M2 = 31
1640 IF SC = 800 THEN LV = 9 : DE = 30  : PRINT "LEVEL "; LV;  " MAYHEM            " : GOSUB 4400 : COLOR = 0 : VLIN 1,38 AT 11 : VLIN 1,38 AT 29
1650 IF SC = 800 THEN COLOR = 12 : VLIN 1,10 AT 11 : VLIN 16,38 AT 11 : VLIN 1,25 AT 29 : VLIN 31,38 AT 29 : MV = 16 : M2 = 31
1660 HTAB 30 : VTAB 23 : PRINT "SCORE: "; SC
1670 RETURN

2000 REM READ KEYBOARD AND UPDATE DIRECTION
2005 KY = PEEK(49152)
2010 IF (KY>127) THEN KY = KY - 128 : POKE 49168,0
2020 IF (DX<>0 AND KY=65) THEN DX = 0 : DY = -1
2030 IF (DX<>0 AND KY=90) THEN DX = 0 : DY = 1
2040 IF (DY<>0 AND KY=8) THEN DX = -1 : DY = 0
2050 IF (DY<>0 AND KY=21) THEN DX = 1 : DY = 0
2060 IF (KY=51) THEN SC=290
2070 IF (KY=54) THEN SC=590
2080 RETURN

2500 REM CHECK DISTANCE FROM MINES
2510 D1 = ABS(FX% - 6)  
2520 D2 = ABS(FX% - 34)
2530 D3 = ABS(FY% - 6)
2540 D4 = ABS(FY% - 34)
2550 IF D1 + D3 < 5 THEN RE = 1 : RETURN
2560 IF D1 + D4 < 5 THEN RE = 1 : RETURN
2570 IF D2 + D3 < 5 THEN RE = 1 : RETURN
2580 IF D2 + D4 < 5 THEN RE = 1 : RETURN
2590 IF (ABS(FX% - SN(SH,0)) + ABS(FY% - SN(SH,1))) < 5 THEN RE = 1
2600 RETURN

3000 REM PROCESS MOVEMENT
3010 IF (SN(SH,0)=FX% AND SN(SH,1)=FY%) THEN SC = SC + 10 : FOR X = SZ-1 TO ST STEP -1 : SN(X+1,0) = SN(X,0) : SN(X+1,1) = SN(X,1) : NEXT X : SZ = SZ + 1 : GW = 1 : GOSUB 1500
3012 IF ((SC - HS) = 10 AND (IN = 0)) THEN IN = 1 : GOSUB 4700
3015 IF (GW=1 AND ST=0) THEN SH = SH + 1
3020 SN(ST,0) = SN(SH,0) + DX
3030 SN(ST,1) = SN(SH,1) + DY
3040 SH = ST
3050 ST = SH + 1
3060 IF (ST>=SZ) THEN ST = 0
3070 IF (SN(SH,0)>38) THEN D$ = "OUT OF BOUNDS RIGHT"  : GOTO 6000
3080 IF (SN(SH,0)<1)  THEN D$ = "OUT OF BOUNDS LEFT"   : GOTO 6000
3090 IF (SN(SH,1)>38) THEN D$ = "OUT OF BOUNDS BOTTOM" : GOTO 6000
3100 IF (SN(SH,1)<1)  THEN D$ = "OUT OF BOUNDS UP"     : GOTO 6000
3110 IF (SCRN(SN(SH,0),SN(SH,1)) = 12) THEN D$ = "GREEN ON PLOT" : GOTO 6000 
3120 A = PEEK(49200)
3130 IF (LV>7) GOSUB 3300
3140 RETURN

3300 REM MOVE WALLS
3305 CL = 0
3310 IF (MV>6) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,MV-3) + SCRN(11,MV-4) + SCRN(11,MV-5)
3315 IF (MV=6) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,MV-3) + SCRN(11,MV-4) + SCRN(11,38)
3320 IF (MV=5) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,MV-3) + SCRN(11,37) + SCRN(11,38)
3325 IF (MV=4) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,36) + SCRN(11,37) + SCRN(11,38)
3330 IF (MV=3) THEN CL = SCRN(11,MV-1) + SCRN(11,35) + SCRN(11,36) + SCRN(11,37) + SCRN(11,38)
3335 IF (MV=2) THEN CL = SCRN(11,34) + SCRN(11,35) + SCRN(11,36) + SCRN(11,37) + SCRN(11,38)
3340 IF (SN(SH,0)=11 OR SN(SH,0)=29) THEN CL=1
3350 IF (MV>6 AND CL=0) THEN COLOR = 0 : PLOT 11,MV : COLOR = 12 : PLOT 11,MV-5 : MV = MV + 1
3355 IF (MV<7 AND CL=0) THEN COLOR = 0 : PLOT 11,MV : COLOR = 12 : PLOT 11,MV+32 : MV = MV + 1
3360 IF (MV=39) THEN MV = 2
3365 CL = 0
3370 IF (M2>6) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,M2-3) + SCRN(29,M2-4) + SCRN(29,M2-5)
3375 IF (M2=6) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,M2-3) + SCRN(29,M2-4) + SCRN(29,38)
3380 IF (M2=5) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,M2-3) + SCRN(29,37) + SCRN(29,38)
3385 IF (M2=4) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,36) + SCRN(29,37) + SCRN(29,38)
3390 IF (M2=3) THEN CL = SCRN(29,M2-1) + SCRN(29,35) + SCRN(29,36) + SCRN(29,37) + SCRN(29,38)
3395 IF (M2=2) THEN CL = SCRN(29,34) + SCRN(29,35) + SCRN(29,36) + SCRN(29,37) + SCRN(29,38)
3400 IF (CL>0) THEN CL = 0 : RETURN
3415 IF (M2=39) THEN M2 = 2
3420 RETURN

