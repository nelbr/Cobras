Variables

SN  // 100 x 2 circular buffer array with 100 X,Y positions for the snake body
SH  // SNAKE HEAD INDEX
ST  // SNAKE TAIL INDEX
SZ  // SNAKE SIZE
DX  // MOVE X DIRECTION
DY  // MOVE Y DIRECTION
FX% // FOOD X POSITION
FY% // FOOD Y POSITION
LV  // LEVEL
DE  // MOVEMENT DELAY
PI  // SOUND PITCH DURATION
SC  // SCORE
HS  // HISCORE
MV  // WALL BRICK TO MOVE NEXT
GW  // GROW SNAKE FLAG
IN  // HI SCORE INTERMISSION FLAG

Subroutines by line number

GAME SETUP          10
GAME LOOP          500
RENDER SNAKE      1000
ADD FOOD          1500
READ KEYBOARD     2000
MINE DISTANCE     2500
PROCESS MOVE      3000
READ HISCORES     3500
PLAY SOUND        4000
TITLE COBRAS      4100
TITLE BYNELBR     4200
RERENDER SNAKE    4300
LEVEL ANIMATION   4400
TITLE LEVEL       4500
TITLE UP!         4600
HISCORE ANIMATION 4700
RENDER MINES      4800
R. MORE MINES     4900
TITLE GAME        5500
TITLE OVER        5700
SAVE HI SCORE     5800
END GAME          6000


10 REM INIT VARIABLES
20 DIM SN(100,1) : DIM S(10) : DIM L(10) : DIM DD(10) : DIM MM(10) : DIM YY(10) : DIM N$(10)
30 PRINT CHR$(4);"BRUN READ.TIME"
35 PRINT CHR$(4);"BLOAD MOCKAUDIO.BIN"
40 GOSUB 3500 : REM READ HI SCORES
50 REM SET LORES GRAPHICS
60 TEXT : HOME : GR
70 COLOR = 15 : HLIN 0,39 AT 0 : HLIN 0,39 AT 39 : VLIN 0,39 AT 0 : VLIN 0,39 AT 39
80 COLOR = 15 : HLIN 0,39 AT 0 : HLIN 0,39 AT 39 : VLIN 0,39 AT 0 : VLIN 0,39 AT 39
90 FOR Y = 30 TO 2 STEP - 2
100 X = 2 : COLOR = 12
110 GOSUB 4100
120 X = 2 : COLOR = 0
130 IF (Y<>2) THEN GOSUB 4100
140 NEXT Y
150 X = 2 : Y = 14 : COLOR = 1 
160 GOSUB 4200
170 HTAB 10 : VTAB 21 : PRINT "PRESS ANY KEY TO BEGIN"
180 BA = 28672
190 CALL BA
200 POKE 28706,204 : POKE 28707,114
210 CALL BA + 3
220 K1 = PEEK (49168)
230 IF PEEK(49152) > 128 GOTO 250
240 CALL BA+9 : FOR X=1 TO 3 : NEXT : GOTO 230
250 CALL BA+6 : COLOR = 0 : X = 2 : Y = 2 : GOSUB 4100
260 X = 2 : Y = 14 : GOSUB 4200
270 HTAB 10 : VTAB 21 : PRINT "                      "

280 COLOR = 15 : HLIN 0,39 AT 0 : HLIN 0,39 AT 39 : VLIN 0,39 AT 0 : VLIN 0,39 AT 39
290 COLOR = 15 : HLIN 0,39 AT 0 : HLIN 0,39 AT 39 : VLIN 0,39 AT 0 : VLIN 0,39 AT 39
300 ST = 0 : DX = 1 : DY = 0 : SZ = 3 : GW = 0 : LV = 1 : DE = 125 : SC = 0 : IN = 0 : MV = 0
310 SH = SZ - 1

320 REM DRAW SNAKE INITIAL POSITION
330 FOR X = 0 TO SZ-1 : SN(X,0) = X+1 : SN(X,1) = 24 : NEXT X
340 COLOR = 12 : GOSUB 4300
350 GOSUB 1500

360 REM GAME TITLE
370 HTAB 12 : VTAB 21
380 PRINT "COBRAS BY NELBR";

500 REM GAME LOOP
510 GOSUB 1000 : REM RENDER SNAKE AFTER MOVEMENT
520 GOSUB 2000 : REM READ KEYBOARD AND UPDATE DIRECTION
530 GOSUB 3000 : REM PROCESS MOVEMENT
540 FOR X=1 TO DE : NEXT X : REM DELAY FOR SPEED MGMT
560 GOTO 500

1000 REM RENDER SNAKE
1020 COLOR = 0  
1030 IF (GW=0) THEN PLOT SN(ST,0), SN(ST,1)
1040 COLOR = 1 
1050 PLOT FX%,FY% 
1060 COLOR = 12
1070 PLOT SN(SH,0), SN(SH,1)
1080 GW = 0
1090 RETURN 

1500 REM ADD FOOD
1510 FX% = RND(1) * 36 + 2
1520 FY% = RND(1) * 36 + 2
1530 IF (SCRN(FX%,FY%)=12) THEN GOTO 1510
1535 IF SC>=300 THEN RE = 0 : GOSUB 2500 : IF RE = 1 GOTO 1510 
1540 HTAB 1 : VTAB 23 : PI = 4 : GOSUB 4000 : GOSUB 4000
1550 IF SC = 0   THEN                     PRINT "LEVEL "; LV;  " BASE GAME!        "
1560 IF SC = 100 THEN LV = 2 : DE = 100 : PRINT "LEVEL "; LV;  " GETTING FASTER!   " : GOSUB 4400
1570 IF SC = 200 THEN LV = 3 : DE = 75  : PRINT "LEVEL "; LV;  " EVEN FASTER!      " : GOSUB 4400
1580 IF SC = 300 THEN LV = 4            : PRINT "LEVEL "; LV;  " OH NO, MINES!     " : GOSUB 4400 : COLOR = 12 : GOSUB 4800
1590 IF SC = 400 THEN LV = 5 :          : PRINT "LEVEL "; LV;  " OH NO, MORE MINES!" : GOSUB 4400 : COLOR = 12 : GOSUB 4900
1600 IF SC = 500 THEN LV = 6 :          : PRINT "LEVEL "; LV;  " ELECTRIFIED WALLS " : GOSUB 4400 : COLOR = 12 : HLIN 5,15 AT 20 : HLIN 25,35 AT 20
1610 IF SC = 600 THEN LV = 7 :            PRINT "LEVEL "; LV;  " NARROW PASSAGE    " : GOSUB 4400 : COLOR = 12 : HLIN 1,18 AT 20 : HLIN 22,38 AT 20
1620 IF SC = 700 THEN LV = 8 :            PRINT "LEVEL "; LV;  " MOVING WALLS      " : GOSUB 4400 : COLOR = 12 : HLIN 1,18 AT 20 : HLIN 22,38 AT 20 : MV = 22
1630 IF SC = 800 THEN LV = 9 : DE = 50  : PRINT "LEVEL "; LV;  " MAYHEM            " : GOSUB 4400 : COLOR = 0 : HLIN 2,38 AT 20 : COLOR = 12 : HLIN 1,18 AT 20 : HLIN 22,38 AT 20 : CL = 0 : MV = 22
1700 HTAB 30 : VTAB 23 
1710 PRINT "SCORE: "; SC
1720 RETURN

2000 REM READ KEYBOARD AND UPDATE DIRECTION
2005 KY = PEEK(49152)
2010 IF (KY>127) THEN KY = KY - 128 : POKE 49168,0
2020 IF (DX<>0 AND KY=65) THEN DX = 0 : DY = -1
2030 IF (DX<>0 AND KY=90) THEN DX = 0 : DY = 1
2040 IF (DY<>0 AND KY=8) THEN DX = -1 : DY = 0
2050 IF (DY<>0 AND KY=21) THEN DX = 1 : DY = 0
2060 IF (KY=51) THEN SC=290
2070 IF (KY=54) THEN SC=590
2080 RETURN

2500 REM CHECK DISTANCE FROM MINES
2510 D1 = ABS(FX% - 6)  
2520 D2 = ABS(FX% - 34)
2530 D3 = ABS(FY% - 6)
2540 D4 = ABS(FY% - 34)
2550 IF D1 + D3 < 5 THEN RE = 1 : RETURN
2560 IF D1 + D4 < 5 THEN RE = 1 : RETURN
2570 IF D2 + D3 < 5 THEN RE = 1 : RETURN
2580 IF D2 + D4 < 5 THEN RE = 1 : RETURN
2590 IF (ABS(FX% - SN(SH,0)) + ABS(FY% - SN(SH,1))) < 5 THEN RE = 1
2600 RETURN

3000 REM PROCESS MOVEMENT
3010 IF (SN(SH,0)=FX% AND SN(SH,1)=FY%) THEN SC = SC + 10 : FOR X = SZ-1 TO ST STEP -1 : SN(X+1,0) = SN(X,0) : SN(X+1,1) = SN(X,1) : NEXT X : SZ = SZ + 1 : GW = 1 : GOSUB 1500
3012 IF ((SC - HS) = 10 AND (IN = 0)) THEN IN = 1 : GOSUB 4700
3015 IF (GW=1 AND ST=0) THEN SH = SH + 1
3020 SN(ST,0) = SN(SH,0) + DX
3030 SN(ST,1) = SN(SH,1) + DY
3040 SH = ST
3050 ST = SH + 1
3060 IF (ST>=SZ) THEN ST = 0
3070 IF (SN(SH,0)>38) THEN GOTO 6000
3080 IF (SN(SH,0)<1)  THEN GOTO 6000
3090 IF (SN(SH,1)>38) THEN GOTO 6000
3100 IF (SN(SH,1)<1)  THEN GOTO 6000
3110 IF (SCRN(SN(SH,0),SN(SH,1)) = 12) GOTO 6000
3120 A = PEEK(49200)
3130 IF (CL>0 AND MV>4) THEN CL = SCRN(MV-1,20) + SCRN(MV-2,20) + SCRN(MV-3,20)
3140 IF (CL>0 AND MV=4) THEN CL = SCRN(MV-1,20) + SCRN(MV-2,20) + SCRN(38,20)
3150 IF (CL>0 AND MV=3) THEN CL = SCRN(MV-1,20) + SCRN(37,20) + SCRN(38,20)
3160 IF (CL>0 AND MV=2) THEN CL = SCRN(36,20) + SCRN(37,20) + SCRN(38,20)
3170 IF (SN(SH,1)=20 AND SC>690) THEN CL = 1
3180 UF (CL>0) THEN RETURN
3190 IF (SC>690 AND MV>4) THEN COLOR = 0 : PLOT MV,20 : COLOR = 12 : PLOT MV-4,20 : MV = MV + 1
3200 IF (SC>690 AND MV<5) THEN COLOR = 0 : PLOT MV,20 : COLOR = 12 : PLOT MV+34,20 : MV = MV + 1
3210 IF (MV=39) THEN MV = 1 
3220 RETURN

3500 PRINT "NAME       SCORE   LEVEL  DATE"
3510 PRINT CHR$(4);"OPEN HISCORE"
3520 PRINT CHR$(4);"READ HISCORE"
3530 FOR X = 1 TO 10
3540 INPUT S(X),L(X),N$(X),YY(X),MM(X),DD(X)
3550 PRINT N$(X);TAB(12);S(X);TAB(20);L(X);TAB(27);MM(X);"/";DD(X);"/";YY(X)
3560 NEXT X
3570 PRINT CHR$(4);"CLOSE HISCORE"
3580 HS = S(1)
3590 PRINT "HIT ANY KEY TO CONTINUE" : GET A$
3600 RETURN

4000 REM QUICK SOUND
4010 FOR X = 1 TO PI : A = PEEK(49200) : NEXT
4020 RETURN

4100 REM WRITE TITLE COBRAS WITH X,Y = TOP LEFT OF TITLE
4110 HLIN X+1,X+4 AT Y : HLIN X+1,X+4 AT Y+6 : VLIN Y+1,Y+5 AT X
4120 X = X + 6 : HLIN X+1,X+3 AT Y : HLIN X+1,X+3 AT Y+6 : VLIN Y+1,Y+5 AT X : VLIN Y+1,Y+5 AT X+4
4130 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X+1,X+3 AT Y : HLIN X+1,X+3 AT Y+3 : HLIN X+1,X+3 AT Y+6 : VLIN Y+1,Y+2 AT X+4 : VLIN Y+4,Y+5 AT X+4
4140 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X+1,X+3 AT Y : HLIN X+1,X+3 AT Y+3 : VLIN Y+1,Y+2 AT X+4 : HLIN X+2,X+4 AT Y+4 : VLIN Y+5,Y+6 AT X+4
4150 X = X + 6 : HLIN X+1,X+3 AT Y : VLIN Y+1,Y+6 AT X : VLIN Y+1,Y+6 AT X+4 : HLIN X+1,X+3 AT Y+3
4160 X = X + 6 : HLIN X+1,X+4 AT Y : HLIN X+1,X+3 AT Y+3 : HLIN X,X+3 AT Y+6 : VLIN Y+1,Y+2 AT X : VLIN Y+4,Y+5 AT X+4
4170 RETURN

4200 REM WRITE BY NELBR WITH X,Y = TOP LEFT OF TEXT
4210 VLIN Y,Y+4 AT X : HLIN X,X+1 AT Y : HLIN X,X+1 AT Y+2 : HLIN X,X+1 AT Y+4 : VLIN Y+1,Y+1 AT X+2 : VLIN Y+3,Y+3 AT X+2
4220 X = X + 4 : VLIN Y,Y+1 AT X : VLIN Y,Y+1 AT X+2 : HLIN X,X+2 AT Y+2 : VLIN Y+2,Y+4 AT X+1
4230 X = X + 6 : VLIN Y,Y+4 AT X : VLIN Y,Y+4 AT X+3 : HLIN X+1,X+1 AT Y+1 : HLIN X+2,X+2 AT Y+2
4240 X = X + 5 : VLIN Y,Y+4 AT X : HLIN X,X+2 AT Y : HLIN X,X+2 AT Y+2 : HLIN X,X+2 AT Y+4
4250 X = X + 4 : VLIN Y,Y+4 AT X : HLIN X,X+2 AT Y+4
4260 X = X + 4 : VLIN Y,Y+4 AT X : HLIN X,X+1 AT Y : HLIN X,X+1 AT Y+2 : HLIN X,X+1 AT Y+4 : VLIN Y+1,Y+1 AT X+2 : VLIN Y+3,Y+3 AT X+2
4270 X = X + 4 : VLIN Y,Y+4 AT X : HLIN X+1,X+2 AT Y : HLIN X+1,X+2 AT Y+2 : VLIN Y+1,Y+1 AT X+2 : HLIN X+1,X+1 AT Y+3 : VLIN Y+4,Y+4 AT X+2
4280 RETURN

4300 REM RENDER FULL SNAKE 
4310 FOR X=0 TO SZ-1 
4320 IF (X<>SH) THEN PLOT SN(X,0), SN(X,1)
4330 NEXT X
4340 GW = 0
4350 RETURN

4400 REM LEVEL UP! INTERMISSION
4410 PI = 100 : GOSUB 4000
4420 COLOR = 2 : X = 10 : Y = 10 : GOSUB 4500
4430 GOSUB 4000 
4440 X = 10 : Y = 20 : GOSUB 4600
4450 GOSUB 4000
4460 COLOR = 0 : X = 10 : Y = 10 : GOSUB 4500
4470 X = 10 : Y = 20 : GOSUB 4600
4480 COLOR = 12 : GOSUB 4300
4490 RETURN

4500 REM WRITE LEVEL AT X,Y POSITION
4510 VLIN Y,Y+6 AT X : HLIN X,X+4 AT Y+6
4520 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X,X+4 AT Y : HLIN X,X+3 AT Y+3 : HLIN X,X+4 AT Y+6
4530 X = X + 6 : VLIN Y,Y+4 AT X : VLIN Y,Y+4 AT X+4 : HLIN X+1,X+3 AT Y+5 : VLIN Y+5,Y+6 AT X+2
4540 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X,X+4 AT Y : HLIN X,X+3 AT Y+3 : HLIN X,X+4 AT Y+6
4550 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X,X+4 AT Y+6
4560 RETURN

4600 REM WRITE UP! AT X,Y POSITION
4610 VLIN Y,Y+5 AT X : VLIN Y,Y+5 AT X+4 : HLIN X+1,X+3 AT Y+6
4620 X = X + 6  : VLIN Y,Y+6 AT X : HLIN X+1,X+3 AT Y : HLIN X+1,X+3 AT Y+3 : VLIN Y+1,Y+2 AT X+4
4630 X = X + 6 : VLIN Y,Y+4 AT X+2 : HLIN X+2,X+2 AT Y+6
4640 RETURN

4700 REM HI SCORE INTERMISSION
4710 PI = 100 : GOSUB 4000
4720 COLOR = 13 : X = 2 : Y = 10 : GOSUB 5000
4730 GOSUB 4000 
4760 COLOR = 0 : X = 2 : Y = 10 : GOSUB 5000
4770 GOSUB 4000
4780 COLOR = 12 : GOSUB 4300 
4790 RETURN

4800 REM DRAW MINES
4810 HLIN 5,7 AT 6 : VLIN 5,7 AT 6
4820 HLIN 33,35 AT 34 : VLIN 33,35 AT 34
4830 RETURN

4900 REM DRAW MORE MINES
4910 HLIN 5,7 AT 34 : VLIN 33,35 AT 6
4920 HLIN 33,35 AT 6 : VLIN 5,7 AT 34
4930 RETURN

5000 REM DRAW HI SCORE
5010 VLIN Y,Y+6 AT X: VLIN Y,Y+6 AT X+4 : HLIN X,X+4 AT Y+3
5020 X = X + 6 : VLIN Y, Y+6 AT X 
5030 X = X + 2 : HLIN X+1,X+4 AT Y : HLIN X+1,X+3 AT Y+3 : HLIN X,X+3 AT Y+6 : VLIN Y+1,Y+2 AT X : VLIN Y+4,Y+5 AT X+4
5040 X = X + 6 : HLIN X+1,X+4 AT Y : HLIN X+1,X+4 AT Y+6 : VLIN Y+1,Y+5 AT X
5050 X = X + 6 : HLIN X+1,X+3 AT Y : HLIN X+1,X+3 AT Y+6 : VLIN Y+1,Y+5 AT X   : VLIN Y+1,Y+5 AT X+4
5060 X = X + 6 : VLIN Y,Y+6 AT X   : HLIN X+1,X+3 AT Y   : HLIN X+1,X+3 AT Y+3 : VLIN Y+1,Y+2 AT X+4 : HLIN X+2,X+4 AT Y+4 : VLIN Y+5,Y+6 AT X+4
5070 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X,X+4 AT Y : HLIN X,X+3 AT Y+3 : HLIN X,X+4 AT Y+6
5080 RETURN

5500 REM GAME 
5510 HLIN X+1,X+4 AT Y : HLIN X+1,X+4 AT Y+6 : VLIN Y+1,Y+5 AT X : VLIN Y+3,Y+5 AT X+4 : HLIN X+2,X+4 AT Y+3
5520 X = X + 6 : HLIN X+1,X+3 AT Y : VLIN Y+1,Y+6 AT X : VLIN Y+1,Y+6 AT X+4 : HLIN X+1,X+3 AT Y+3
5530 X = X + 6 : VLIN Y,Y+6 AT X : VLIN Y,Y+6 AT X+4 : VLIN Y+2,Y+6 AT X+2 : HLIN X+1,X+1 AT Y+1 : HLIN X+3,X+3 AT Y+1
5540 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X,X+4 AT Y : HLIN X,X+3 AT Y+3 : HLIN X,X+4 AT Y+6
5550 RETURN

5700 REM OVER
5710 HLIN X+1,X+3 AT Y : HLIN X+1,X+3 AT Y+6 : VLIN Y+1,Y+5 AT X : VLIN Y+1,Y+5 AT X+4
5720 X = X + 6 : VLIN Y,Y+4 AT X : VLIN Y,Y+4 AT X+4 : HLIN X+1,X+3 AT Y+5 : VLIN Y+5,Y+6 AT X+2
5730 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X,X+4 AT Y : HLIN X,X+3 AT Y+3 : HLIN X,X+4 AT Y+6
5740 X = X + 6 : VLIN Y,Y+6 AT X : HLIN X+1,X+3 AT Y : HLIN X+1,X+3 AT Y+3 : VLIN Y+1,Y+2 AT X+4 : HLIN X+2,X+4 AT Y+4 : VLIN Y+5,Y+6 AT X+4
5750 RETURN

5800 REM NEW HIGH SCORE
5810 HTAB 1 : VTAB 21 : PRINT "NEW HIGH SCORE "; SC; ", CONGRATULATIONS!"
5820 INPUT "NAME? "; A$
5830 IF (LEN(A$)>10) THEN A$ = LEFT$(A$,10)
5840 FOR X = 10 TO 2 STEP -1 
5850 N$(X) = N$(X-1) : S(X) = S(X-1) : L(X) = L(X-1) : DD(X) = DD(X-1) : MM(X) = MM(X-1) : YY(X) = YY(X-1) : HS = SC
5860 NEXT X
5870 CALL 779 
5880 T$ = "" 
5890 FOR X=640 TO 657 
5900 V=PEEK(X) : IF V>128 THEN V = V - 128
5910 T$ = T$ + CHR$(V): NEXT X
5920 MM(1) = VAL( MID$(T$,1,2) )
5930 DD(1) = VAL( MID$(T$,4,2) )
5940 YY(1) = VAL( MID$(T$,7,2) )
5950 N$(1) = A$ : S(1) = SC : L(1) = LV 
5960 PRINT CHR$(4);"OPEN HISCORE"
5970 PRINT CHR$(4);"WRITE HISCORE"
5980 FOR X=1 TO 10 
5990 PRINT S(X);",";L(X);",";N$(X);",";YY(X);",";MM(X);",";DD(X)
5995 NEXT
5998 PRINT CHR$(4);"CLOSE HISCORE"
5999 RETURN

6000 REM END GAME ROUTINE
6010 GR : COLOR = 1 : X = 10 : Y = 10
6020 GOSUB 5500
6030 X = 10 : Y = 20
6040 GOSUB 5700
6050 FOR X = 1 TO 2000 : NEXT X : A = PEEK (49168) 
6060 IF (IN=1) THEN GOSUB 5800
6070 HTAB 1 : VTAB 24 : PRINT "PRESS X TO EXIT, OTHER KEY TO RESTART";
6080 GET A$ : IF A$ <> "X" THEN HOME : GR : GOTO 210
6090 TEXT : HOME : END



