3300 REM MOVE WALLS
3305 CL = 0
3310 IF (MV>6) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,MV-3) + SCRN(11,MV-4) + SCRN(11,MV-5)
3315 IF (MV=6) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,MV-3) + SCRN(11,MV-4) + SCRN(11,38)
3320 IF (MV=5) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,MV-3) + SCRN(11,37) + SCRN(11,38)
3325 IF (MV=4) THEN CL = SCRN(11,MV-1) + SCRN(11,MV-2) + SCRN(11,36) + SCRN(11,37) + SCRN(11,38)
3330 IF (MV=3) THEN CL = SCRN(11,MV-1) + SCRN(11,35) + SCRN(11,36) + SCRN(11,37) + SCRN(11,38)
3335 IF (MV=2) THEN CL = SCRN(11,34) + SCRN(11,35) + SCRN(11,36) + SCRN(11,37) + SCRN(11,38)
3340 IF (SN(SH,0)=11 OR SN(SH,0)=29) THEN CL=1
3350 IF (MV>6 AND CL=0) THEN COLOR = 0 : PLOT 11,MV : COLOR = 12 : PLOT 11,MV-5 : MV = MV + 1
3355 IF (MV<7 AND CL=0) THEN COLOR = 0 : PLOT 11,MV : COLOR = 12 : PLOT 11,MV+32 : MV = MV + 1
3360 IF (MV=39) THEN MV = 2
3365 CL = 0
3370 IF (M2>6) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,M2-3) + SCRN(29,M2-4) + SCRN(29,M2-5)
3375 IF (M2=6) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,M2-3) + SCRN(29,M2-4) + SCRN(29,38)
3380 IF (M2=5) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,M2-3) + SCRN(29,37) + SCRN(29,38)
3385 IF (M2=4) THEN CL = SCRN(29,M2-1) + SCRN(29,M2-2) + SCRN(29,36) + SCRN(29,37) + SCRN(29,38)
3390 IF (M2=3) THEN CL = SCRN(29,M2-1) + SCRN(29,35) + SCRN(29,36) + SCRN(29,37) + SCRN(29,38)
3395 IF (M2=2) THEN CL = SCRN(29,34) + SCRN(29,35) + SCRN(29,36) + SCRN(29,37) + SCRN(29,38)
3400 IF (CL>0) THEN CL = 0 : RETURN
3415 IF (M2=39) THEN M2 = 2
3420 RETURN

