W1  // SNAKE OCCUPANCY ON WALL 1, STOPS WALL MOVEMENT
H1  // WALL HEAD POINTER ALLOWS TO MOVE WALL AS IF IT WERE A SNAKE
T1  // WALL TAIL POINTER ALLOWS TO MOVE WALL AS IF IT WERE A SNAKE
W2  // SNAKE OCCUPANCY ON WALL 2, STOPS WALL MOVEMENT
H2  // HEAD POINTER FOR SECOND WALL
T2  // TAILS POINTER FOR SECOND WALL


