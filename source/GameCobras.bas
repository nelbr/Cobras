2040 IF (DY<>0 AND KY=136) THEN DX = -1 : DY =  0
2050 IF (DY<>0 AND KY=149) THEN DX =  1 : DY =  0
2060 IF (KY=179) THEN SC=290
2070 IF (KY=182) THEN SC=590
2080 RETURN

3000 REM PROCESS MOVEMENT
3010 IF (GW=1) GOTO 3040
3020 ON LV GOTO 1450, 1450, 1450, 1100, 1150, 1200, 1250, 1450, 1450, 1400
3030 COLOR = 0 : PLOT SN(ST,0), SN(ST,1) : ST = ST + 1
3040 SH = SH + 1 : IF SH>=100 THEN SH=0 : SN(SH,0) = SN(99,0) + DX : SN(SH,1) = SN(99,1) + DY : GOTO 3060
